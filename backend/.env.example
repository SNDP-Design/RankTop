# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
SESSION_SECRET=change-this-to-any-random-32-char-string-in-production
BACKEND_URL=https://your-app-name.onrender.com
FRONTEND_URL=https://sndp-design.github.io

# ── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Gmail (OAuth2 — NOT your regular password) ───────────────────────────────
# Follow BACKEND_SETUP.md to get these
GMAIL_USER=your@gmail.com
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GMAIL_REFRESH_TOKEN=1//xxxx

# ── Google Search Console (same OAuth2 client, same or separate refresh token)
# GSC_REFRESH_TOKEN=1//xxxx  # Only needed if you use a separate token for GSC

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_TIMEZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use default ./ranktop.db
# DB_PATH=/data/ranktop.db
